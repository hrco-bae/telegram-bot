# Telegram Bot Token
# https://t.me/BotFather 에서 발급받은 토큰을 붙여넣으세요
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Upstash Redis (구독자 목록 & 중복전송 이력 저장)
# Vercel 프로젝트에 Upstash Redis 통합을 연결하면 자동으로 채워집니다.
UPSTASH_REDIS_REST_URL=YOUR_UPSTASH_REDIS_REST_URL_HERE
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REDIS_REST_TOKEN_HERE

# 카카오워크 Incoming Webhook (선택)
# 카카오워크 확장 서비스 > Incoming Webhook > Bot 만들기에서 발급받은 URL을 붙여넣으세요.
# 비워두면 카카오워크 전송은 건너뜁니다.
KAKAOWORK_WEBHOOK_URL=
